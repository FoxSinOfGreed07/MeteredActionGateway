# Gateway (api + worker)
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=mag:
PORT=3000
LOG_LEVEL=info
OPS_API_KEY=ops-dev-key
# LLM classifier: fake by default; set ANTHROPIC_API_KEY (and optionally LLM_MODEL) to use Claude
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Seed + scripts
MOCK_ERP_URL=http://localhost:4000
GATEWAY_URL=http://localhost:3000
WEBHOOK_SECRET=dev-webhook-secret

# Mock ERP
MOCK_ERP_PORT=4000
MOCK_ERP_WEBHOOK_URL=http://localhost:3000/v1/webhooks/erp/sap-main
MOCK_ERP_WEBHOOK_SECRET=dev-webhook-secret
MOCK_ERP_WEBHOOK_DELAY_MS=500
MOCK_ERP_RATE_LIMIT_RPS=100
MOCK_ERP_RATE_LIMIT_BURST=100
MOCK_ERP_SEED=42

# Tests
TEST_DATABASE_ADMIN_URL=postgres://gateway:gateway@localhost:5432/postgres
TEST_REDIS_URL=redis://localhost:6379
SCENARIO_TIME_SCALE=0.1
